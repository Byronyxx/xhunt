# ─────────────────────────────────────────────────────────────────────────────
# XHunt Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth Service (Python FastAPI backend) ─────────────────────────────────────
# URL of the running Python auth service
NEXT_PUBLIC_AUTH_URL=http://localhost:8000
# JWT secret — MUST match backend/.env JWT_SECRET
# Generate: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq (primary — mission generation, step adaptation, recommendations)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic Claude (secondary — deep-think agent reasoning)
# https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret — Stripe Dashboard → Developers → Webhooks
# Endpoint URL: https://your-domain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address — must be from a verified domain in Resend dashboard
EMAIL_FROM=X-Hunt <noreply@xhunt.app>

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://xhunt.app

# ── Cron Security ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# ─────────────────────────────────────────────────────────────────────────────
# Deployment checklist:
# 1. Generate JWT_SECRET: openssl rand -hex 64
# 2. Copy JWT_SECRET to backend/.env as JWT_SECRET
# 3. Set NEXT_PUBLIC_AUTH_URL to your deployed auth service URL
# 4. Set all variables in your deployment platform (Vercel → Settings → Env Vars)
# 5. Configure Stripe webhook endpoint in Stripe Dashboard
# 6. Run Supabase migrations: supabase db push or apply migrations/*.sql
# 7. Start backend: cd backend && docker-compose up -d
# ─────────────────────────────────────────────────────────────────────────────
