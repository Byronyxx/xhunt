# ─────────────────────────────────────────────────────────────────────────────
# XHunt Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dwiferekcfaqxcgkyacw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_C2XNBKXnmLJTD8rVzENj5w_3ZnNqero
# Dashboard → Settings → API → Service role key (secret — never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth Service (Python FastAPI — deployed on Render) ────────────────────────
NEXT_PUBLIC_AUTH_URL=https://xhunt-fsm2.onrender.com
# JWT secret — MUST be copied from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
# This exact value must also be set as JWT_SECRET on the Render service.
JWT_SECRET=

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq (primary — mission generation, step adaptation, recommendations)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic Claude (secondary — deep-think agent reasoning)
# https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret — Stripe Dashboard → Developers → Webhooks
# Endpoint URL: https://xhunt.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address — must be from a verified domain in Resend dashboard
EMAIL_FROM=X-Hunt <noreply@xhunt.app>

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://xhunt.app

# ── Cron Security ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Same value must be set on Render service as CRON_SECRET
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment checklist
# ─────────────────────────────────────────────────────────────────────────────
#
# VERCEL (Next.js app):
#   Set all variables above in Vercel Dashboard → Settings → Environment Variables
#
# RENDER (Python backend — srv-d8pekhtckfvc73cuf99g):
#   Required env vars on the Render service:
#     SUPABASE_URL            = https://dwiferekcfaqxcgkyacw.supabase.co
#     SUPABASE_SERVICE_ROLE_KEY = <from Supabase Dashboard>
#     JWT_SECRET              = <MUST match Supabase JWT Secret>
#     ALLOWED_ORIGINS         = https://xhunt.app,https://xhunt-fsm2.onrender.com
#     NEXT_PUBLIC_APP_URL     = https://xhunt.app
#     CRON_SECRET             = <same value as Vercel CRON_SECRET>
#     GROQ_API_KEY            = <same as Vercel>
#     REDIS_URL               = <Upstash or Render Redis URL>
#     APP_ENV                 = production
#
# SUPABASE:
#   Run migrations in order:
#     supabase db push   (or apply each file in supabase/migrations/ manually)
#   The JWT_SECRET in Render/Vercel MUST equal the JWT secret shown at:
#     Supabase Dashboard → Settings → API → JWT Settings
#
# STRIPE:
#   Register webhook endpoint in Stripe Dashboard:
#     URL: https://xhunt.app/api/stripe/webhook
#     Events: customer.subscription.*, invoice.payment_failed
# ─────────────────────────────────────────────────────────────────────────────
